{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hooviestar",
  "version": "0.1.6",
  "identifier": "xyz.openhoo.hooviestar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      { "label": "studio", "title": "Hooviestar", "width": 1440, "height": 900, "minWidth": 800, "minHeight": 560, "maximized": true }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage"],
    "shortDescription": "Native GPU scene compositor for Discord",
    "longDescription": "Compose windows, displays, text, images and local media into a clean Program window for Discord screen sharing.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libpipewire-0.3-0",
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MjJDQ0Q2N0FGQjI4QjMKUldTektQdDYxc3dpdHc5ZC9IeGFyZ2UxY3RWVmxCZi8yTU0vMHpCa00vNnpHNHFkZHdrNlk1cEoK",
      "endpoints": [
        "https://github.com/openhoo/hooviestar/releases/latest/download/latest.json"
      ]
    }
  }
}
